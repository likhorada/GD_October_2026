[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Hazard"
2d_physics/layer_3="Collectible"
2d_physics/layer_4="NPC"
2d_physics/layer_5="Trigger"
2d_physics/layer_6="Hair"

[physics]

2d/default_gravity=900.0
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
